<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PackageId>CodingLombok.LombokAlgoritma</PackageId>
    <Version>0.2.0</Version>
    <Authors>codinglombok</Authors>
    <Description>LombokAlgoritma — deterministic algorithm library (C# port, partial; see README status). Zero dependencies.</Description>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/codinglombok/LombokAlgoritma</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- the xunit project in tests/ has its own csproj; keep its sources out of the library -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
