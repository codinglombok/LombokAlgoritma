{
  "name": "lombokalgoritma",
  "version": "0.1.1",
  "description": "LombokAlgoritma — deterministic, zero-dependency algorithm library (sort, search, graph, math, string, data structures, ML). TypeScript reference of the Lombok Ecosystem.",
  "author": "codinglombok <codinglombok@gmail.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/codinglombok/LombokAlgoritma",
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/LombokAlgoritma.git"
  },
  "bugs": {
    "url": "https://github.com/codinglombok/LombokAlgoritma/issues"
  },
  "keywords": [
    "algorithm",
    "algorithms",
    "sort",
    "search",
    "graph",
    "data-structure",
    "machine-learning",
    "compression",
    "geometry",
    "string-algorithms",
    "wasm",
    "zero-dependency",
    "multi-language",
    "lombok-ecosystem",
    "typescript",
    "javascript",
    "dijkstra",
    "quicksort",
    "mergesort",
    "astar",
    "huffman",
    "kmeans",
    "bloom-filter",
    "pagerank"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./sort": {
      "types": "./dist/types/sort/index.d.ts",
      "import": "./dist/esm/sort/index.js",
      "require": "./dist/cjs/sort/index.js"
    },
    "./search": {
      "types": "./dist/types/search/index.d.ts",
      "import": "./dist/esm/search/index.js",
      "require": "./dist/cjs/search/index.js"
    },
    "./graph": {
      "types": "./dist/types/graph/index.d.ts",
      "import": "./dist/esm/graph/index.js",
      "require": "./dist/cjs/graph/index.js"
    },
    "./math": {
      "types": "./dist/types/math/index.d.ts",
      "import": "./dist/esm/math/index.js",
      "require": "./dist/cjs/math/index.js"
    },
    "./string": {
      "types": "./dist/types/string/index.d.ts",
      "import": "./dist/esm/string/index.js",
      "require": "./dist/cjs/string/index.js"
    },
    "./compression": {
      "types": "./dist/types/compression/index.d.ts",
      "import": "./dist/esm/compression/index.js",
      "require": "./dist/cjs/compression/index.js"
    },
    "./datastructure": {
      "types": "./dist/types/datastructure/index.d.ts",
      "import": "./dist/esm/datastructure/index.js",
      "require": "./dist/cjs/datastructure/index.js"
    },
    "./geometry": {
      "types": "./dist/types/geometry/index.d.ts",
      "import": "./dist/esm/geometry/index.js",
      "require": "./dist/cjs/geometry/index.js"
    },
    "./ml": {
      "types": "./dist/types/ml/index.d.ts",
      "import": "./dist/esm/ml/index.js",
      "require": "./dist/cjs/ml/index.js"
    },
    "./concurrent": {
      "types": "./dist/types/concurrent/index.d.ts",
      "import": "./dist/esm/concurrent/index.js",
      "require": "./dist/cjs/concurrent/index.js"
    },
    "./crypto": {
      "types": "./dist/types/crypto/index.d.ts",
      "import": "./dist/esm/crypto/index.js",
      "require": "./dist/cjs/crypto/index.js"
    },
    "./hardware": {
      "types": "./dist/types/hardware/index.d.ts",
      "import": "./dist/esm/hardware/index.js",
      "require": "./dist/cjs/hardware/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:esm": "tsup --format esm",
    "build:cjs": "tsup --format cjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "vectors:generate": "tsx scripts/generate_vectors.ts",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "counts": "tsx scripts/count_algorithms.ts --write",
    "counts:check": "tsx scripts/count_algorithms.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^10.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "lombokecc": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "lombokecc": {
      "optional": true
    }
  }
}
